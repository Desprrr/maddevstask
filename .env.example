# Настройки только для docker-compose (Variant "Docker" из README).
# Docker Compose сам подхватывает файл `.env` рядом с docker-compose.yml —
# скопируйте этот файл в `.env` и поправьте порты, если дефолтные заняты
# на вашей машине/сервере (типичная история для 8000 — его часто занимает
# что-то ещё). Ничего менять не обязательно: без .env используются дефолты
# ниже.

# Порт, на котором будет доступно приложение (дашборд + проксируемый API/WS)
FRONTEND_PORT=8080

# Backend API напрямую (для отладки/curl) — публикуется отдельно от
# frontend, но не обязателен для работы самого приложения
BACKEND_PORT=8000

# Веб-инбокс Mailpit (смотреть письма-заглушки)
MAILPIT_UI_PORT=8025

# target-emulator напрямую (посмотреть/потыкать вручную)
TARGET_EMULATOR_PORT=9100
