DATABASE_URL=postgresql+asyncpg://monitor:monitor@localhost:5432/monitor

# fake: пишет письма в таблицу sent_emails и в лог, ничего никуда не отправляет
# smtp: реально отправляет по SMTP (по умолчанию рассчитан на Mailpit из docker-compose)
EMAIL_BACKEND=fake
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=monitor@example.com

CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
